# Copy this to .env and edit before running
# cp .env.example .env

# REQUIRED — change this to a strong random secret
API_SECRET=change-this-to-a-strong-random-secret

# LLM model — phi3:mini is best for 4GB RAM
# Other options: qwen2.5-coder:1.5b  (slightly smaller, better at code)
LLM_MODEL=qwen2.5-coder:1.5b

# Master server external IP (used when slaves on remote servers need to connect)
# MASTER_EXTERNAL_IP=192.168.1.100
OLLAMA_BASE_URL=http://ollama:11434
